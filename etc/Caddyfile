:$PORT
root * /usr/share/caddy
file_server browse

header {
    X-Robots-Tag none
    X-Content-Type-Options nosniff
    X-Frame-Options DENY
    Referrer-Policy no-referrer-when-downgrade
}

basicauth /$AUUID/* {
    $AUUID $MYUUID-HASH
}

@xhttp_xray_vless {
header Connection *Upgrade*
header Upgrade    xhttp
path /$AUUID-vless
}
reverse_proxy @xhttp_xray_vless unix//etc/caddy/vless

@xhttp_xray_trojan {
header Connection *Upgrade*
header Upgrade    xhttp
path /$AUUID-trojan
}
reverse_proxy @xhttp_xray_trojan unix//etc/caddy/trojan

@xhttp_xray_ss {
header Connection *Upgrade*
header Upgrade    xhttp
path /$AUUID-ss
}
reverse_proxy @xhttp_xray_ss 127.0.0.1:4234

@xhttp_xray_socks {
header Connection *Upgrade*
header Upgrade    xhttp
path /$AUUID-socks
}
reverse_proxy @xhttp_xray_socks 127.0.0.1:5234
